{
  "name": "pi-purge",
  "version": "2.0.0",
  "description": "pi-purge：从 dsh-purge-safe 二开而来的 DeepSeek Harness 破甲与红队评测插件。让所有模型都能破甲，不同模型可换不同提示词；默认提示词面向国模「鸢码」。满血版本 + Super Agent 适配，面向 DSH 0.2.2-rc.3；优化提示词，降低拒绝率，提升稳定性。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuguang-ZFG/pi-purge.git"
  },
  "homepage": "https://github.com/zhuguang-ZFG/pi-purge#readme",
  "bugs": {
    "url": "https://github.com/zhuguang-ZFG/pi-purge/issues"
  },
  "author": "zhuguang-ZFG (derived from CallMeGuLab/dsh-purge-safe)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "pi-purge": "bin/pi-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "!lib/default-prompt-inject.md.bak",
    "!lib/default-prompt-inject.zh.md",
    "!lib/default-prompt-inject.en.md",
    "bin",
    "docs",
    "!docs/agents",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "release-notes.md",
    "LICENSE",
    "CONTRIBUTORS.md",
    "CONTRIBUTING.md",
    "NOTICE",
    "README.zh-CN.md",
    "README.ja.md",
    "!**/.git",
    "!**/.{git,idea,vscode,codex,claude,agents,windsurf,cursor,ssh,aws,azure,secrets,scratch}/**",
    "!**/.config/gcloud/**",
    "!**/secrets/**",
    "!**/.env",
    "!**/.env.*",
    "!**/{.npmrc,.pypirc,.netrc,_netrc}",
    "!**/*.{pem,key,p12,pfx,keystore,jks}",
    "!**/{id_rsa,id_dsa,id_ecdsa,id_ed25519}",
    "!**/{credentials,credentials.*,service-account*}.json",
    "!**/default-prompt-inject*.md",
    "!**/*.{bak,asar,tgz,log}",
    "!**/{.DS_Store,Thumbs.db}",
    "!**/*.{iml,ipr,iws,code-workspace}",
    "!scripts/{tmp,test}-*.mjs"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.2-rc.3",
  "dshTargets": [
    "0.2.2-rc.3"
  ]
}
